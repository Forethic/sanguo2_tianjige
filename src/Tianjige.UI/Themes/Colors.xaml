<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 汉末五色·底色（绢帛沉木） -->
    <Color x:Key="ColorBgDarkWood">#1F1A16</Color>
    <Color x:Key="ColorBgSandalwood">#2B241E</Color>
    <Color x:Key="ColorBgCard">#26201B</Color>
    <Color x:Key="ColorBgCardHover">#332B24</Color>
    <Color x:Key="ColorBgOverlay">#E6191410</Color>

    <!-- 简帛素米·文本颜色 -->
    <Color x:Key="ColorTextPrimary">#E6DAC0</Color>
    <Color x:Key="ColorTextSecondary">#A89E8C</Color>
    <Color x:Key="ColorTextMuted">#706657</Color>

    <!-- 砂金古铜·边框与金属装饰 -->
    <Color x:Key="ColorGoldBorder">#C8A355</Color>
    <Color x:Key="ColorGoldBorderDark">#4A3B2C</Color>
    <Color x:Key="ColorGoldMuted">#6B5832</Color>
    <Color x:Key="ColorGoldLight">#E8C982</Color>

    <!-- 朱砂赤红·印信与武将技 -->
    <Color x:Key="ColorCinnabar">#A63428</Color>
    <Color x:Key="ColorCinnabarDark">#7D2016</Color>
    <Color x:Key="ColorCinnabarLight">#C7483C</Color>
    <Color x:Key="ColorSkillGeneral">#C23829</Color>

    <!-- 幽蓝玄青·军师技 -->
    <Color x:Key="ColorSkillMilitary">#2E6B9E</Color>
    <Color x:Key="ColorSkillMilitaryDark">#1D4A6E</Color>

    <!-- 玉印气运·状态色 -->
    <Color x:Key="ColorJadeActive">#3CB371</Color>
    <Color x:Key="ColorJadeInactive">#6E6860</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BrushBgDarkWood" Color="{StaticResource ColorBgDarkWood}" />
    <SolidColorBrush x:Key="BrushBgSandalwood" Color="{StaticResource ColorBgSandalwood}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}" />
    <SolidColorBrush x:Key="BrushBgCardActive" Color="#3D2C1C" />
    <SolidColorBrush x:Key="BrushBgOverlay" Color="{StaticResource ColorBgOverlay}" />
    <SolidColorBrush x:Key="BrushBadgeBg" Color="#241D17" />
    <SolidColorBrush x:Key="BrushBadgeBorder" Color="#4A3C2D" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <SolidColorBrush x:Key="BrushGoldBorder" Color="{StaticResource ColorGoldBorder}" />
    <SolidColorBrush x:Key="BrushGoldBorderDark" Color="{StaticResource ColorGoldBorderDark}" />
    <SolidColorBrush x:Key="BrushGoldMuted" Color="{StaticResource ColorGoldMuted}" />
    <SolidColorBrush x:Key="BrushGoldLight" Color="{StaticResource ColorGoldLight}" />
    <SolidColorBrush x:Key="BrushGoldText" Color="{StaticResource ColorGoldLight}" />

    <SolidColorBrush x:Key="BrushCinnabar" Color="{StaticResource ColorCinnabar}" />
    <SolidColorBrush x:Key="BrushCinnabarDark" Color="{StaticResource ColorCinnabarDark}" />
    <SolidColorBrush x:Key="BrushCinnabarLight" Color="{StaticResource ColorCinnabarLight}" />
    <SolidColorBrush x:Key="BrushSkillGeneral" Color="{StaticResource ColorSkillGeneral}" />

    <SolidColorBrush x:Key="BrushSkillMilitary" Color="{StaticResource ColorSkillMilitary}" />
    <SolidColorBrush x:Key="BrushSkillMilitaryDark" Color="{StaticResource ColorSkillMilitaryDark}" />

    <SolidColorBrush x:Key="BrushJadeActive" Color="{StaticResource ColorJadeActive}" />
    <SolidColorBrush x:Key="BrushJadeInactive" Color="{StaticResource ColorJadeInactive}" />

    <!-- 沉木绢帛渐变底色 -->
    <LinearGradientBrush x:Key="BrushWoodSilkGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1F1A16" Offset="0.0" />
        <GradientStop Color="#28211B" Offset="0.5" />
        <GradientStop Color="#231C17" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 古铜边框金石渐变 -->
    <LinearGradientBrush x:Key="BrushGoldGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8C982" Offset="0.0" />
        <GradientStop Color="#C8A355" Offset="0.5" />
        <GradientStop Color="#8C6E2D" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
