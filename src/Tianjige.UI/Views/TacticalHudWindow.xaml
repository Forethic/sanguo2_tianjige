<Window x:Class="Tianjige.UI.Views.TacticalHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Tianjige.UI.Views"
        xmlns:vm="clr-namespace:Tianjige.UI.ViewModels"
        mc:Ignorable="d"
        Title="群英策 · 天机阁 —— 战局参谋 HUD"
        Width="400" Height="1080"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsTopmost}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        Icon="../Resources/app_icon.ico">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- 外层汉式古风卷轴边框 -->
    <Border Background="{StaticResource BrushWoodSilkGradient}"
            BorderBrush="{StaticResource BrushGoldBorder}"
            BorderThickness="1.5,0,0,0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="-4" Opacity="0.85" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: 顶栏古风标题与窗口控制 -->
                <RowDefinition Height="38" />
                <!-- 1: 模块切换标签栏 (将星录 / 兵机盘) -->
                <RowDefinition Height="36" />
                <!-- 2: 主参谋台工作区 -->
                <RowDefinition Height="*" />
                <!-- 3: 运筹底栏 (岁次时令与气运印信) -->
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- 0: 标题栏 (支持鼠标拖拽移动) -->
            <Border Grid.Row="0"
                    Background="#191411"
                    BorderBrush="{StaticResource BrushGoldMuted}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 图标与主标题 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="../Resources/app_icon.png" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock Text="群英策 · 天机阁"
                                   FontFamily="{StaticResource FontLiSu}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushGoldLight}"
                                   VerticalAlignment="Center" />
                        <Border Background="{StaticResource BrushCinnabarDark}"
                                CornerRadius="2"
                                Padding="4,1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="战局 HUD" FontSize="8" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>

                    <!-- 右侧控制按钮组 (返回启动台 / 置顶 / 最小化 / 关闭) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 返回启动台 -->
                        <Button Click="BackToLauncher_Click"
                                Margin="0,0,4,0"
                                Padding="5,2"
                                Cursor="Hand"
                                Style="{StaticResource StyleAncientButton}"
                                Content="⚙️ 启动台"
                                FontSize="9"
                                ToolTip="打开启动配置台" />

                        <!-- 置顶切换图钉按钮 -->
                        <Button Command="{Binding ToggleTopmostCommand}"
                                Width="26" Height="22"
                                Margin="0,0,4,0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PinBorder"
                                            Background="#251F1A"
                                            BorderBrush="{StaticResource BrushGoldMuted}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True">
                                        <Path x:Name="PinIcon"
                                              Width="11" Height="12"
                                              Stretch="Uniform"
                                              Fill="{StaticResource BrushGoldLight}"
                                              Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22L12,23L13,22V16H18V14L16,12Z" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                            <Setter TargetName="PinBorder" Property="Background" Value="#382A1B" />
                                            <Setter TargetName="PinBorder" Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                            <Setter TargetName="PinIcon" Property="Fill" Value="#FFE6A3" />
                                            <Setter Property="ToolTip" Value="窗口已置顶 (点击取消置顶)" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTopmost}" Value="False">
                                            <Setter TargetName="PinBorder" Property="Background" Value="#1C1713" />
                                            <Setter TargetName="PinBorder" Property="BorderBrush" Value="#44372D" />
                                            <Setter TargetName="PinIcon" Property="Fill" Value="#75675A" />
                                            <Setter TargetName="PinIcon" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="45" CenterX="5.5" CenterY="6" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="ToolTip" Value="窗口未置顶 (点击固定在最前端)" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PinBorder" Property="BorderBrush" Value="#FFE6A8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 最小化 -->
                        <Button Click="Minimize_Click"
                                Width="24" Height="22"
                                Margin="0,0,3,0"
                                Style="{StaticResource StyleAncientButton}"
                                Content="—"
                                FontSize="10" />

                        <!-- 关闭 -->
                        <Button Click="Close_Click"
                                Width="24" Height="22"
                                Style="{StaticResource StyleAncientButton}"
                                Content="✕"
                                FontSize="10" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1: 参谋模块标签栏 -->
            <Border Grid.Row="1"
                    Background="#211B16"
                    BorderBrush="{StaticResource BrushGoldMuted}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 将星录 Tab -->
                    <Button Grid.Column="0"
                            Command="{Binding SwitchTabCommand}"
                            CommandParameter="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="TabBorder" Background="Transparent">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="★" FontSize="11" Margin="0,0,3,0" x:Name="TabIcon" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="将星录"
                                                       FontFamily="{StaticResource FontLiSu}"
                                                       FontSize="13"
                                                       x:Name="TabText"
                                                       Foreground="{StaticResource BrushTextSecondary}" />
                                        </StackPanel>
                                        <Border x:Name="ActiveLine"
                                                Height="2"
                                                Background="{StaticResource BrushGoldBorder}"
                                                VerticalAlignment="Bottom"
                                                Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGeneralStarSelected}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#2B231D" />
                                        <Setter TargetName="TabText" Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                        <Setter TargetName="TabText" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="TabIcon" Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                        <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 兵机盘 Tab -->
                    <Button Grid.Column="1"
                            Command="{Binding SwitchTabCommand}"
                            CommandParameter="1"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="TabBorder" Background="Transparent">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="☯" FontSize="11" Margin="0,0,3,0" x:Name="TabIcon" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="兵机盘"
                                                       FontFamily="{StaticResource FontLiSu}"
                                                       FontSize="13"
                                                       x:Name="TabText"
                                                       Foreground="{StaticResource BrushTextSecondary}" />
                                        </StackPanel>
                                        <Border x:Name="ActiveLine"
                                                Height="2"
                                                Background="{StaticResource BrushGoldBorder}"
                                                VerticalAlignment="Bottom"
                                                Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsTroopCompassSelected}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#2B231D" />
                                        <Setter TargetName="TabText" Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                        <Setter TargetName="TabText" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="TabIcon" Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                        <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 天下势 Tab -->
                    <Button Grid.Column="2"
                            Command="{Binding SwitchTabCommand}"
                            CommandParameter="2"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="TabBorder" Background="Transparent">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🗺" FontSize="11" Margin="0,0,3,0" x:Name="TabIcon" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBlock Text="天下势"
                                                       FontFamily="{StaticResource FontLiSu}"
                                                       FontSize="13"
                                                       x:Name="TabText"
                                                       Foreground="{StaticResource BrushTextSecondary}" />
                                        </StackPanel>
                                        <Border x:Name="ActiveLine"
                                                Height="2"
                                                Background="{StaticResource BrushGoldBorder}"
                                                VerticalAlignment="Bottom"
                                                Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWorldSituationSelected}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#2B231D" />
                                        <Setter TargetName="TabText" Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                        <Setter TargetName="TabText" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="TabIcon" Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                        <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 2: 主参谋工作台内容区 -->
            <Grid Grid.Row="2">
                <views:GeneralStarView DataContext="{Binding GeneralStarVm}"
                                      Visibility="{Binding DataContext.IsGeneralStarSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <views:TroopCompassView DataContext="{Binding TroopCompassVm}"
                                        Visibility="{Binding DataContext.IsTroopCompassSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <views:WorldSituationView DataContext="{Binding WorldSituationVm}"
                                          Visibility="{Binding DataContext.IsWorldSituationSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <!-- 3: 运筹底栏 -->
            <Border Grid.Row="3"
                    Background="#15110E"
                    BorderBrush="{StaticResource BrushGoldMuted}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 岁次与战局状态（自动溢出省略，避免遮挡右侧状态印信） -->
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="10.5"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,8,0">
                        <Run Text="📜 " />
                        <Run Text="{Binding SeasonTitle, Mode=OneWay}" />
                        <Run Text=" · " Foreground="{StaticResource BrushGoldMuted}" />
                        <Run Text="{Binding BattleStatusText, Mode=OneWay}" Foreground="{StaticResource BrushGoldLight}" />
                    </TextBlock>

                    <Border Grid.Column="1"
                            Background="#231A14"
                            BorderBrush="{StaticResource BrushGoldMuted}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="5,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontSize="9"
                                   Foreground="{StaticResource BrushGoldLight}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
