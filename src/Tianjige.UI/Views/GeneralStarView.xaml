<UserControl x:Class="Tianjige.UI.Views.GeneralStarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:Tianjige.UI.Controls"
             xmlns:models="clr-namespace:Tianjige.Core.Models;assembly=Tianjige.Core"
             xmlns:services="clr-namespace:Tianjige.Core.Services;assembly=Tianjige.Core"
             xmlns:vm="clr-namespace:Tianjige.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="380">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- 搜索框 -->
            <RowDefinition Height="Auto" />
            <!-- 武将快捷栏 -->
            <RowDefinition Height="Auto" />
            <!-- 武将名片与技能长卷 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索栏 (支持输入拼音/文字，带快速清空按钮) -->
        <Border Grid.Row="0" Margin="10,8,10,6">
            <Grid>
                <TextBox Style="{StaticResource StyleAncientSearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="键入拼音秒搜 (如: gy / tsc / 关羽)..."
                         Padding="8,5,28,5" />
                <Button Content="✕"
                        Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Width="20" Height="20"
                        Padding="0"
                        FontSize="11"
                        Cursor="Hand"
                        Background="Transparent"
                        Foreground="{StaticResource BrushGoldLight}"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FFE299" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- 武将快速索引区：类别选项卡与精选武将徽章 (告别400武将拥挤) -->
        <Border Grid.Row="1" Margin="10,0,10,8">
            <StackPanel>
                <!-- 非检索状态：古风类别选项卡 (星选 / 无双 / 谋主 / 君主 / 良将) -->
                <Border Background="#1C1612"
                        BorderBrush="{StaticResource BrushGoldBorderDark}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="2"
                        Margin="0,0,0,6"
                        Visibility="{Binding IsBrowsing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 星选 -->
                        <Button Grid.Column="0" Command="{Binding SetCategoryCommand}" CommandParameter="精选"
                                Content="★ 精选" Margin="1,0" Padding="2,3" FontSize="11" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource StyleAncientButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCategoryFeatured}" Value="True">
                                            <Setter Property="Background" Value="#4C341F" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 无双 -->
                        <Button Grid.Column="1" Command="{Binding SetCategoryCommand}" CommandParameter="无双"
                                Content="⚔ 无双" Margin="1,0" Padding="2,3" FontSize="11" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource StyleAncientButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCategoryWuShuang}" Value="True">
                                            <Setter Property="Background" Value="#4C341F" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 谋主 -->
                        <Button Grid.Column="2" Command="{Binding SetCategoryCommand}" CommandParameter="谋主"
                                Content="📜 谋主" Margin="1,0" Padding="2,3" FontSize="11" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource StyleAncientButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCategoryMouZhu}" Value="True">
                                            <Setter Property="Background" Value="#4C341F" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 君主 -->
                        <Button Grid.Column="3" Command="{Binding SetCategoryCommand}" CommandParameter="君主"
                                Content="👑 君主" Margin="1,0" Padding="2,3" FontSize="11" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource StyleAncientButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCategoryMonarch}" Value="True">
                                            <Setter Property="Background" Value="#4C341F" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 良将 -->
                        <Button Grid.Column="4" Command="{Binding SetCategoryCommand}" CommandParameter="良将"
                                Content="🛡 良将" Margin="1,0" Padding="2,3" FontSize="11" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource StyleAncientButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCategoryLiangJiang}" Value="True">
                                            <Setter Property="Background" Value="#4C341F" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- 检索状态提示栏 -->
                <DockPanel Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                           LastChildFill="False"
                           Margin="2,0,2,6">
                    <TextBlock Text="{Binding SearchStatusText}"
                               FontSize="11.5"
                               Foreground="{StaticResource BrushGoldLight}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <!-- 选定分类或搜索候选名录横向微滚动条 (仅限15-25位，告别400武将拥挤) -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DisplayedGenerals}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RosterGeneralItem}">
                                <Button Content="{Binding Name}"
                                        Command="{Binding DataContext.SelectGeneralCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding General}"
                                        Margin="0,0,5,0"
                                        Padding="9,3"
                                        FontSize="12"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StyleAncientButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#4C341F" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                                    <Setter Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 主内容区：武将主卡与技能时间轴 -->
        <ScrollViewer Grid.Row="2" 
                      Margin="10,0,10,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 武将核心名片头 -->
                <Border Background="#241E19" 
                        BorderBrush="{StaticResource BrushGoldBorder}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="14,12"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：武将头像框 / 印玺降级回退 -->
                        <Border Grid.Column="0"
                                Width="58" Height="58"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#1A1410"
                                BorderBrush="{StaticResource BrushGoldBorder}"
                                BorderThickness="1.2"
                                CornerRadius="4"
                                Margin="0,2,14,0"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <!-- 底层 fallback: 纯正古风朱红/紫檀姓氏印章 -->
                                <Border Background="#2B1814" CornerRadius="3">
                                    <TextBlock Text="{Binding SelectedGeneralInitial}"
                                               FontFamily="{StaticResource FontAncient}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushGoldLight}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- 顶层: 武将真实肖像 (如果存在路径并能加载，则覆盖显示；否则透明穿透展示姓氏印) -->
                                <Image Source="{Binding SelectedGeneralAvatarPath}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>

                        <!-- 右侧：武将详情 (大名、印章资质、三维属性、客观评语) -->
                        <StackPanel Grid.Column="1" DataContext="{Binding SelectedGeneral}">
                            <!-- 第一行：大名 + 朱砂印章资质 -->
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding Name}" 
                                           Style="{StaticResource StyleTitleLarge}"
                                           VerticalAlignment="Center" />
                                <controls:SealBadge Tier="{Binding SealTier}" 
                                                    DockPanel.Dock="Right"
                                                    VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- 属性数值行 -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 武力 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="初始武力" Style="{StaticResource StyleBodySecondary}" />
                                    <TextBlock Text="{Binding BaseForce}" Style="{StaticResource StyleStatNumber}" Foreground="#FFA496" />
                                </StackPanel>
                                <!-- 智力 -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="初始智力" Style="{StaticResource StyleBodySecondary}" />
                                    <TextBlock Text="{Binding BaseIntellect}" Style="{StaticResource StyleStatNumber}" Foreground="#96CBF5" />
                                </StackPanel>
                                <!-- 兵种 -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="初始统兵" Style="{StaticResource StyleBodySecondary}" />
                                    <TextBlock Text="{Binding InitialTroop}" Style="{StaticResource StyleStatNumber}" Foreground="{StaticResource BrushGoldLight}" />
                                </StackPanel>
                            </Grid>

                            <Separator Style="{StaticResource StyleAncientSeparator}" Margin="0,10" />

                            <!-- 客观特色评语 -->
                            <TextBlock Text="{Binding Comment}" 
                                       Style="{StaticResource StyleBody}" 
                                       Foreground="#C8BEB0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 技能树标题与操作提示 -->
                <DockPanel Margin="2,4,2,6">
                    <TextBlock Text="全周期技能长卷 (1~40级展开)" Style="{StaticResource StyleTitleSmall}" VerticalAlignment="Center" />
                    <TextBlock Text="点击技能名称可逆查全图掌握将领" 
                               Style="{StaticResource StyleBodySecondary}" 
                               DockPanel.Dock="Right" 
                               Foreground="{StaticResource BrushGoldMuted}" 
                               VerticalAlignment="Center" />
                </DockPanel>

                <!-- 技能分类筛选选项卡 (全部 / ⚔ 武将技 / 📜 军师技) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding SetSkillFilterCommand}"
                            CommandParameter="0"
                            Height="28"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="TabBorder"
                                        Background="#221C18"
                                        BorderBrush="#473A2D"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="全部技能" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" x:Name="TabText"/>
                                        <TextBlock Text="{Binding AllSkillsCount, StringFormat=' ({0})'}" FontSize="10.5" Foreground="{StaticResource BrushGoldMuted}" VerticalAlignment="Center" x:Name="CountText"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#382C20" />
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                        <Setter TargetName="TabText" Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                        <Setter TargetName="TabText" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="CountText" Property="Foreground" Value="{StaticResource BrushGoldLight}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding SetSkillFilterCommand}"
                            CommandParameter="1"
                            Height="28"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="TabBorder"
                                        Background="#221C18"
                                        BorderBrush="#473A2D"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⚔ 武将技" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" x:Name="TabText"/>
                                        <TextBlock Text="{Binding GeneralSkillsCount, StringFormat=' ({0})'}" FontSize="10.5" Foreground="{StaticResource BrushGoldMuted}" VerticalAlignment="Center" x:Name="CountText"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterGeneral}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#381914" />
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#D94536" />
                                        <Setter TargetName="TabText" Property="Foreground" Value="#FFA89E" />
                                        <Setter TargetName="TabText" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="CountText" Property="Foreground" Value="#FFA89E" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="4"
                            Command="{Binding SetSkillFilterCommand}"
                            CommandParameter="2"
                            Height="28"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="TabBorder"
                                        Background="#221C18"
                                        BorderBrush="#473A2D"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📜 军师技" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" x:Name="TabText"/>
                                        <TextBlock Text="{Binding MilitarySkillsCount, StringFormat=' ({0})'}" FontSize="10.5" Foreground="{StaticResource BrushGoldMuted}" VerticalAlignment="Center" x:Name="CountText"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterMilitary}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#17283B" />
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3D80B8" />
                                        <Setter TargetName="TabText" Property="Foreground" Value="#90C8FA" />
                                        <Setter TargetName="TabText" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="CountText" Property="Foreground" Value="#90C8FA" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 技能时间轴长卷 -->
                <controls:SkillTimeline SkillTree="{Binding DisplayedSkills}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 技能逆查弹窗遮罩浮层 (Reverse Lookup Drawer) -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#EE14100D"
                Visibility="{Binding IsReverseLookupOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Padding="16"
                d:IsHidden="True">
            <Border Background="#211B17" 
                    BorderBrush="{StaticResource BrushGoldBorder}" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 弹窗标题与关闭按钮 (避免拉伸变大) -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <Button Content="✕ 关闭" 
                                Command="{Binding CloseReverseLookupCommand}" 
                                DockPanel.Dock="Right"
                                Style="{StaticResource StyleAncientButton}"
                                Padding="10,2"
                                Height="24"
                                FontSize="11"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ReverseLookupSkillName, StringFormat='掌握【{0}】之全图名录'}" 
                                   Style="{StaticResource StyleTitleMedium}" 
                                   Foreground="{StaticResource BrushGoldLight}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- 逆查名录列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReverseLookupMasters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:SkillMasteryInfo}">
                                    <Border Background="#2B231D" 
                                            BorderBrush="#473A2B" 
                                            BorderThickness="1" 
                                            CornerRadius="3" 
                                            Padding="10,6" 
                                            Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock Text="{Binding UnlockLevel, StringFormat='Lv.{0}'}" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource BrushGoldLight}" 
                                                       Width="44" 
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding GeneralName}" 
                                                       FontFamily="{StaticResource FontAncient}" 
                                                       FontSize="15" 
                                                       Foreground="{StaticResource BrushTextPrimary}" 
                                                       Width="60" 
                                                       VerticalAlignment="Center" />
                                            <controls:SealBadge Tier="{Binding SealTier}" 
                                                                Margin="6,0" 
                                                                VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding BaseForce, StringFormat='武 {0}'}" 
                                                       Foreground="#E68A7E" 
                                                       Margin="8,0,0,0" 
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding BaseIntellect, StringFormat='智 {0}'}" 
                                                       Foreground="#8EC0E4" 
                                                       Margin="8,0,0,0" 
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
