<UserControl x:Class="Tianjige.UI.Views.GeneralStarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:Tianjige.UI.Controls"
             xmlns:models="clr-namespace:Tianjige.Core.Models;assembly=Tianjige.Core"
             xmlns:services="clr-namespace:Tianjige.Core.Services;assembly=Tianjige.Core"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="380">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- 搜索框 -->
            <RowDefinition Height="Auto" />
            <!-- 武将快捷栏 -->
            <RowDefinition Height="Auto" />
            <!-- 武将名片与技能长卷 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索栏 -->
        <Border Grid.Row="0" Margin="10,8,10,6">
            <TextBox Style="{StaticResource StyleAncientSearchBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="键入拼音秒搜 (如: gy / tsc / 关羽)..." />
        </Border>

        <!-- 筛选武将快捷横滑条/下拉候选 -->
        <Border Grid.Row="1" Margin="10,0,10,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredGenerals}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:GeneralStaticInfo}">
                            <Button Content="{Binding Name}"
                                    Command="{Binding DataContext.SelectGeneralCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,6,0"
                                    Padding="8,3"
                                    FontSize="12"
                                    Style="{StaticResource StyleAncientButton}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 主内容区：武将主卡与技能时间轴 -->
        <ScrollViewer Grid.Row="2" 
                      Margin="10,0,10,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel DataContext="{Binding SelectedGeneral}">
                <!-- 武将核心名片头 -->
                <Border Background="#241E19" 
                        BorderBrush="{StaticResource BrushGoldBorder}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <!-- 第一行：大名 + 朱砂印章资质 -->
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{Binding Name}" 
                                       Style="{StaticResource StyleTitleLarge}"
                                       VerticalAlignment="Center" />
                            <controls:SealBadge Tier="{Binding SealTier}" 
                                                DockPanel.Dock="Right"
                                                VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- 属性数值行 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 武力 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="初始武力" Style="{StaticResource StyleBodySecondary}" />
                                <TextBlock Text="{Binding BaseForce}" Style="{StaticResource StyleStatNumber}" Foreground="#E68A7E" />
                            </StackPanel>
                            <!-- 智力 -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="初始智力" Style="{StaticResource StyleBodySecondary}" />
                                <TextBlock Text="{Binding BaseIntellect}" Style="{StaticResource StyleStatNumber}" Foreground="#8EC0E4" />
                            </StackPanel>
                            <!-- 兵种 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="初始统兵" Style="{StaticResource StyleBodySecondary}" />
                                <TextBlock Text="{Binding InitialTroop}" Style="{StaticResource StyleStatNumber}" Foreground="{StaticResource BrushGoldLight}" />
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource StyleAncientSeparator}" />

                        <!-- 客观特色评语 -->
                        <TextBlock Text="{Binding Comment}" 
                                   Style="{StaticResource StyleBody}" 
                                   FontStyle="Italic"
                                   Foreground="#C4B9A5" />
                    </StackPanel>
                </Border>

                <!-- 全周期技能树长卷标题 -->
                <DockPanel Margin="2,4,2,8">
                    <TextBlock Text="全周期技能长卷 (1~40级展开)" Style="{StaticResource StyleTitleSmall}" />
                    <TextBlock Text="点击技能名称可逆查全图掌握将领" 
                               Style="{StaticResource StyleBodySecondary}" 
                               DockPanel.Dock="Right" 
                               Foreground="{StaticResource BrushGoldMuted}" 
                               VerticalAlignment="Center" />
                </DockPanel>

                <!-- 技能时间轴长卷 -->
                <controls:SkillTimeline SkillTree="{Binding SkillTree}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 技能逆查弹窗遮罩浮层 (Reverse Lookup Drawer) -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#EE14100D"
                Visibility="{Binding IsReverseLookupOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Padding="16"
                d:IsHidden="True">
            <Border Background="#211B17" 
                    BorderBrush="{StaticResource BrushGoldBorder}" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 弹窗标题与关闭按钮 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding ReverseLookupSkillName, StringFormat='掌握【{0}】之全图名录'}" 
                                   Style="{StaticResource StyleTitleMedium}" 
                                   Foreground="{StaticResource BrushGoldLight}" />
                        <Button Content="✕ 关闭" 
                                Command="{Binding CloseReverseLookupCommand}" 
                                DockPanel.Dock="Right"
                                Style="{StaticResource StyleAncientButton}"
                                Padding="8,2" />
                    </DockPanel>

                    <!-- 逆查名录列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReverseLookupMasters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:SkillMasteryInfo}">
                                    <Border Background="#2B231D" 
                                            BorderBrush="#473A2B" 
                                            BorderThickness="1" 
                                            CornerRadius="3" 
                                            Padding="10,6" 
                                            Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock Text="{Binding UnlockLevel, StringFormat='Lv.{0}'}" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource BrushGoldLight}" 
                                                       Width="44" 
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding GeneralName}" 
                                                       FontFamily="{StaticResource FontAncient}" 
                                                       FontSize="15" 
                                                       Foreground="{StaticResource BrushTextPrimary}" 
                                                       Width="60" 
                                                       VerticalAlignment="Center" />
                                            <controls:SealBadge Tier="{Binding SealTier}" 
                                                                Margin="6,0" 
                                                                VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding BaseForce, StringFormat='武 {0}'}" 
                                                       Foreground="#E68A7E" 
                                                       Margin="8,0,0,0" 
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding BaseIntellect, StringFormat='智 {0}'}" 
                                                       Foreground="#8EC0E4" 
                                                       Margin="8,0,0,0" 
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
