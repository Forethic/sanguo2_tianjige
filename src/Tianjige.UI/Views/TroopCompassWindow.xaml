<Window x:Class="Tianjige.UI.Views.TroopCompassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tianjige.UI.ViewModels"
        mc:Ignorable="d"
        Title="兵机罗盘 · 兵符生克与八门阵法"
        Width="1260" Height="820"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsTopmost}"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="../Resources/app_icon.ico">

    <!-- 外层汉风边框 -->
    <Border Background="{StaticResource BrushWoodSilkGradient}"
            BorderBrush="{StaticResource BrushGoldBorder}"
            BorderThickness="1.8"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.95" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: 顶栏拖拽与控制区 -->
                <RowDefinition Height="42" />
                <!-- 1: 主内容区 (两大独立一级选项卡) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 0: 顶栏 (拖拽区 + 置顶与关闭) -->
            <Border Grid.Row="0"
                    Background="#191411"
                    CornerRadius="7,7,0,0"
                    BorderBrush="{StaticResource BrushGoldMuted}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="☯ 天机兵机盘 · " FontFamily="{StaticResource FontLiSu}" FontSize="16" Foreground="{StaticResource BrushGoldLight}" VerticalAlignment="Center" />
                        <TextBlock Text="兵符生克与八门阵法运筹" FontFamily="{StaticResource FontLiSu}" FontSize="16" FontWeight="Bold" Foreground="#FFE49E" VerticalAlignment="Center" />
                        <Border Background="#2B2117" BorderBrush="{StaticResource BrushGoldMuted}" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="官方 PAK 原版矩阵 · 拓扑流向与实战全景速查" FontSize="11" Foreground="{StaticResource BrushGoldLight}" />
                        </Border>
                    </StackPanel>

                    <!-- 控制按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 置顶图钉 -->
                        <Button Command="{Binding ToggleTopmostCommand}"
                                Width="28" Height="24"
                                Margin="0,0,8,0"
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="PinBorder"
                                                Background="#251F1A"
                                                BorderBrush="{StaticResource BrushGoldMuted}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Path x:Name="PinIcon"
                                                  Width="11" Height="12"
                                                  Stretch="Uniform"
                                                  Fill="{StaticResource BrushGoldLight}"
                                                  Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22L12,23L13,22V16H18V14L16,12Z" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                <Setter TargetName="PinBorder" Property="Background" Value="#382A1B" />
                                                <Setter TargetName="PinBorder" Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                                <Setter TargetName="PinIcon" Property="Fill" Value="#FFE6A3" />
                                                <Setter Property="ToolTip" Value="窗口已置顶 (点击取消置顶)" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="False">
                                                <Setter TargetName="PinBorder" Property="Background" Value="#1C1713" />
                                                <Setter TargetName="PinBorder" Property="BorderBrush" Value="#44372D" />
                                                <Setter TargetName="PinIcon" Property="Fill" Value="#75675A" />
                                                <Setter Property="ToolTip" Value="窗口未置顶 (点击固定在最前端)" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                        </Button>

                        <!-- 关闭按钮 -->
                        <Button Click="Close_Click"
                                Width="28" Height="24"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseBorder"
                                            Background="#251F1A"
                                            BorderBrush="{StaticResource BrushGoldMuted}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <Path x:Name="CloseIcon"
                                              Width="10" Height="10"
                                              Stretch="Uniform"
                                              Fill="{StaticResource BrushGoldLight}"
                                              Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBorder" Property="Background" Value="#8A2318" />
                                            <Setter TargetName="CloseBorder" Property="BorderBrush" Value="#E06A3B" />
                                            <Setter TargetName="CloseIcon" Property="Fill" Value="#FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1: 主内容区: 顶级两大典籍独立选项卡 (兵符生克 vs 阵法克制) -->
            <TabControl Grid.Row="1"
                        SelectedIndex="{Binding SelectedTabIndex}"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="12,6,12,10">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder"
                                            Background="#1E1712"
                                            BorderBrush="{StaticResource BrushGoldBorder}"
                                            BorderThickness="1.2,1.2,1.2,0"
                                            CornerRadius="5,5,0,0"
                                            Padding="22,8"
                                            Margin="0,0,8,0"
                                            Cursor="Hand">
                                        <ContentPresenter ContentSource="Header" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#2D2015" />
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="1.5,1.5,1.5,0" />
                                            <Setter Property="Foreground" Value="#FFE6A3" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#261C14" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- ======================================================== -->
                <!-- 选项卡 1: 十三正规兵符拓扑圆盘与静态生克透析全景           -->
                <!-- ======================================================== -->
                <TabItem Header="⚔️ 十三正规兵符生克全景">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <!-- 左: 兵符点选与拓扑圆盘 (540px) -->
                            <ColumnDefinition Width="540" />
                            <!-- 中间分割线 -->
                            <ColumnDefinition Width="1" />
                            <!-- 右: 静态生克透析全景大面板 (*) -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左列: 兵种快速点选与拓扑生克轮盘画布 -->
                        <Border Grid.Column="0"
                                Background="#120E0B"
                                BorderBrush="{StaticResource BrushGoldMuted}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 0: 顶部兵种快速点选按钮矩阵 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 1: 拓扑圆盘贝塞尔曲线画布 -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 0: 顶部兵符单键速选条 -->
                                <Border Grid.Row="0"
                                        Background="#18130F"
                                        BorderBrush="{StaticResource BrushGoldBorderDark}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,6"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False" Margin="0,0,0,5">
                                            <TextBlock Text="【兵符速选】" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushGoldLight}" VerticalAlignment="Center" />
                                            <TextBlock Text="※ 点击任一兵种，右侧立即静态罗列其克制与被克关系" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </DockPanel>

                                        <!-- 13大兵种单键按钮群 -->
                                        <WrapPanel>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="长枪兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="长枪" FontSize="11" Foreground="#4A90E2" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="朴刀兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="朴刀" FontSize="11" Foreground="#E06A3B" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="大刀兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="大刀" FontSize="11" Foreground="#4A90E2" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="弓箭兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="弓箭" FontSize="11" Foreground="#48C774" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="弩兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="弩兵" FontSize="11" Foreground="#48C774" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="链锤兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="链锤" FontSize="11" Foreground="#4A90E2" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="飞刀兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="飞刀" FontSize="11" Foreground="#48C774" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="铁锤兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="铁锤" FontSize="11" Foreground="#4A90E2" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="武斗兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="武斗" FontSize="11" Foreground="#E06A3B" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="蛮族兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="蛮族" FontSize="11" Foreground="#E06A3B" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="藤甲兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="藤甲" FontSize="11" Foreground="#E06A3B" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="黄巾兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="黄巾" FontSize="11" Foreground="#B07D48" />
                                            </Button>
                                            <Button Command="{Binding SelectTroopCommand}" CommandParameter="女兵" Style="{StaticResource StyleAncientButton}" Height="23" Padding="6,0" Margin="0,0,4,4">
                                                <TextBlock Text="女兵" FontSize="11" Foreground="#E06A3B" />
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 1: 拓扑圆盘贝塞尔曲线画布 (Viewbox自适应缩放) -->
                                <Viewbox Grid.Row="1" Width="510" Height="510" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="640" Height="640">
                                        <!-- 轮盘背景装饰同心圆 -->
                                        <Canvas Width="640" Height="640">
                                            <!-- 外围虚线大圆 -->
                                            <Ellipse Canvas.Left="65" Canvas.Top="65" Width="510" Height="510"
                                                     Stroke="#22C8A355" StrokeDashArray="4 4" StrokeThickness="1.2" />
                                            <!-- 节点主轨道圆 -->
                                            <Ellipse Canvas.Left="92" Canvas.Top="92" Width="456" Height="456"
                                                     Stroke="#33C8A355" StrokeThickness="1.5" />
                                            <!-- 内圈同心圆 -->
                                            <Ellipse Canvas.Left="180" Canvas.Top="180" Width="280" Height="280"
                                                     Stroke="#18C8A355" StrokeThickness="1" />
                                            <!-- 核心天机阵眼 -->
                                            <Border Canvas.Left="255" Canvas.Top="255" Width="130" Height="130"
                                                    CornerRadius="65"
                                                    Background="#1C1510"
                                                    BorderBrush="{StaticResource BrushGoldBorder}"
                                                    BorderThickness="1.8">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.8"/>
                                                </Border.Effect>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="☯" FontSize="26" Foreground="{StaticResource BrushGoldLight}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding SelectedTroop.TroopName, FallbackValue='长枪兵'}"
                                                               FontFamily="{StaticResource FontLiSu}" FontSize="15" FontWeight="Bold"
                                                               Foreground="#FFE49E" HorizontalAlignment="Center"/>
                                                    <Border Background="#2B2117" CornerRadius="2" Padding="4,1" Margin="0,3,0,0" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedTroop.CategoryName, FallbackValue='长兵器'}"
                                                                   FontSize="10" Foreground="#C8A355"/>
                                                    </Border>
                                                    <TextBlock Text="绿出线克 · 红入线败" FontSize="9" Foreground="#887766" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Canvas>

                                        <!-- 生克贝塞尔有向连线层 -->
                                        <ItemsControl ItemsSource="{Binding ChordLines}" Width="640" Height="640">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas IsItemsHost="True" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding PathData}"
                                                          Stroke="{Binding Stroke}"
                                                          StrokeThickness="{Binding StrokeThickness}"
                                                          Opacity="{Binding Opacity}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 13大兵种圆周节点层 -->
                                        <ItemsControl ItemsSource="{Binding TroopNodes}" Width="640" Height="640">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas IsItemsHost="True" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectTroopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding TroopName}"
                                                            Width="56" Height="56"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid>
                                                                    <!-- 节点圆盘背景与外环 -->
                                                                    <Border x:Name="NodeBorder"
                                                                            Width="56" Height="56"
                                                                            CornerRadius="28"
                                                                            Background="#1B140F"
                                                                            BorderBrush="{Binding BorderColor}"
                                                                            BorderThickness="2">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect x:Name="NodeShadow" Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.7"/>
                                                                        </Border.Effect>

                                                                        <Grid>
                                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                                <TextBlock Text="{Binding ShortName}"
                                                                                           FontFamily="{StaticResource FontLiSu}"
                                                                                           FontSize="14" FontWeight="Bold"
                                                                                           Foreground="#F2E6D0"
                                                                                           HorizontalAlignment="Center" />
                                                                                <TextBlock Text="{Binding CategoryShort}"
                                                                                           FontSize="10"
                                                                                           Foreground="{Binding CategoryColor}"
                                                                                           HorizontalAlignment="Center"
                                                                                           Margin="0,1,0,0"/>
                                                                            </StackPanel>

                                                                            <!-- 右上角角标 (+胜 / -败 / 主选) -->
                                                                            <Border x:Name="RelationPill"
                                                                                    CornerRadius="3"
                                                                                    Padding="3,0"
                                                                                    HorizontalAlignment="Right"
                                                                                    VerticalAlignment="Top"
                                                                                    Margin="0,-3,-3,0"
                                                                                    Visibility="Collapsed">
                                                                                <TextBlock x:Name="RelationText"
                                                                                           Text="{Binding RelationBadgeText}"
                                                                                           FontSize="9" FontWeight="Bold"
                                                                                           Foreground="#FFFFFF" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <!-- 主选高亮 -->
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="NodeBorder" Property="Background" Value="#382915" />
                                                                        <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#FFD700" />
                                                                        <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2.8" />
                                                                        <Setter TargetName="RelationPill" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="RelationPill" Property="Background" Value="#FF9800" />
                                                                    </DataTrigger>
                                                                    <!-- 我克对方高亮 -->
                                                                    <DataTrigger Binding="{Binding IsStrong}" Value="True">
                                                                        <Setter TargetName="NodeBorder" Property="Background" Value="#1B2B1E" />
                                                                        <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#00E676" />
                                                                        <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2.2" />
                                                                        <Setter TargetName="RelationPill" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="RelationPill" Property="Background" Value="#2E7D32" />
                                                                    </DataTrigger>
                                                                    <!-- 对方克我高亮 -->
                                                                    <DataTrigger Binding="{Binding IsWeak}" Value="True">
                                                                        <Setter TargetName="NodeBorder" Property="Background" Value="#2B1818" />
                                                                        <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#FF5252" />
                                                                        <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2.2" />
                                                                        <Setter TargetName="RelationPill" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="RelationPill" Property="Background" Value="#C62828" />
                                                                    </DataTrigger>
                                                                    <!-- 悬停微缩放 -->
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="NodeBorder" Property="Background" Value="#281D14" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- 中间分隔线 -->
                        <Rectangle Grid.Column="1" Fill="#2E241B" />

                        <!-- 右列: 静态克制全景透析看板 (直接静态展示克制与被克关系) -->
                        <Border Grid.Column="2" Background="#16120E" BorderBrush="{StaticResource BrushGoldBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="10,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- 1. 选定兵种主卡 -->
                                    <Border Background="#201812" BorderBrush="{StaticResource BrushGoldBorder}" BorderThickness="1.2" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="☯" FontSize="20" Foreground="{StaticResource BrushGoldLight}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SelectedTroop.TroopName}" FontFamily="{StaticResource FontLiSu}" FontSize="24" FontWeight="Bold" Foreground="#FFE6A3" />
                                                    <Border Background="#2E2117" BorderBrush="{StaticResource BrushGoldBorder}" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedTroop.CategoryName}" FontSize="11" FontWeight="Bold" Foreground="#FFD580" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedTroop.Characteristics}" TextWrapping="Wrap" FontSize="11.5" Foreground="#DDD0C2" Margin="0,8,0,0" LineHeight="18" />
                                                <TextBlock Text="{Binding SelectedTroop.ChantQuote, StringFormat='秘传要诀：{0}'}" FontStyle="Italic" FontSize="11.5" Foreground="#FFB74D" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 2. 静态展示: 我方绝对克制 / 优势对阵兵种 (绿色优势 · 出线胜局) -->
                                    <Border Background="#121F16" BorderBrush="#2E7D32" BorderThickness="1.2" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                <TextBlock Text="🟢 我方绝对克制 · 大优敌方兵种 (大胜局)" FontWeight="Bold" FontSize="13" Foreground="#81C784" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding AdvantageList.Count, StringFormat='{}共 {0} 种被我方克制'}" FontSize="11" Foreground="#A5D6A7" VerticalAlignment="Center" DockPanel.Dock="Right" />
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding AdvantageList}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectTroopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Opponent}"
