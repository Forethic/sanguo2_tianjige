<Window x:Class="Tianjige.UI.Views.TroopCounterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tianjige.UI.ViewModels"
        mc:Ignorable="d"
        Title="兵符相克 · 三国群英传2 兵种生克全景大典"
        Width="1180" Height="820"
        MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsTopmost}"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Icon="../Resources/app_icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- 外层汉风边框 -->
    <Border Background="{StaticResource BrushWoodSilkGradient}"
            BorderBrush="{StaticResource BrushGoldBorder}"
            BorderThickness="1.8"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.95" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: 顶栏拖拽与控制区 -->
                <RowDefinition Height="42" />
                <!-- 1: 核心口诀速查横幅 -->
                <RowDefinition Height="Auto" />
                <!-- 2: 主内容工作区 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 0: 顶栏 (拖拽区 + 置顶与关闭) -->
            <Border Grid.Row="0"
                    Background="#191411"
                    CornerRadius="7,7,0,0"
                    BorderBrush="{StaticResource BrushGoldMuted}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚔️ 兵种相克 · " FontFamily="{StaticResource FontLiSu}" FontSize="16" Foreground="{StaticResource BrushGoldLight}" VerticalAlignment="Center" />
                        <TextBlock Text="兵符生克全景大典" FontFamily="{StaticResource FontLiSu}" FontSize="16" FontWeight="Bold" Foreground="#FFE49E" VerticalAlignment="Center" />
                        <Border Background="#2B2117" BorderBrush="{StaticResource BrushGoldMuted}" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="原版 PAK 完整相克数据 · 全部克制关系免点击直接展示" FontSize="11" Foreground="{StaticResource BrushGoldLight}" />
                        </Border>
                    </StackPanel>

                    <!-- 控制按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 置顶图钉 -->
                        <Button Command="{Binding ToggleTopmostCommand}"
                                Width="28" Height="24"
                                Margin="0,0,8,0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PinBorder"
                                            Background="#251F1A"
                                            BorderBrush="{StaticResource BrushGoldMuted}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <Path x:Name="PinIcon"
                                              Width="11" Height="12"
                                              Stretch="Uniform"
                                              Fill="{StaticResource BrushGoldLight}"
                                              Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22L12,23L13,22V16H18V14L16,12Z" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                            <Setter TargetName="PinBorder" Property="Background" Value="#382A1B" />
                                            <Setter TargetName="PinBorder" Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                            <Setter TargetName="PinIcon" Property="Fill" Value="#FFE6A3" />
                                            <Setter Property="ToolTip" Value="窗口已置顶 (点击取消置顶)" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTopmost}" Value="False">
                                            <Setter TargetName="PinBorder" Property="Background" Value="#1C1713" />
                                            <Setter TargetName="PinBorder" Property="BorderBrush" Value="#44372D" />
                                            <Setter TargetName="PinIcon" Property="Fill" Value="#75675A" />
                                            <Setter Property="ToolTip" Value="窗口未置顶 (点击固定在最前端)" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 关闭按钮 -->
                        <Button Click="Close_Click"
                                Width="28" Height="24"
                                Style="{StaticResource StyleAncientButton}"
                                Content="✕"
                                FontSize="11"
                                ToolTip="关闭本窗口" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1: 核心口诀速查横幅 (一览无遗) -->
            <Border Grid.Row="1" Background="#1D1713" BorderBrush="{StaticResource BrushGoldMuted}" BorderThickness="0,0,0,1" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#36281D" BorderBrush="{StaticResource BrushGoldBorder}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="☯ 生克秘诀" FontFamily="{StaticResource FontLiSu}" FontSize="12.5" FontWeight="Bold" Foreground="#FFE6A3" />
                    </Border>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Background="#251C15" BorderBrush="#554433" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="0,0,8,4">
                            <TextBlock FontSize="11.5" Foreground="#FFE49E">
                                <Run Text="【长兵克短兵】" FontWeight="Bold" Foreground="#81D4FA" />
                                <Run Text="长枪兵 克 朴刀兵/藤甲/蛮族" />
                            </TextBlock>
                        </Border>

                        <Border Background="#251C15" BorderBrush="#554433" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="0,0,8,4">
                            <TextBlock FontSize="11.5" Foreground="#FFE49E">
                                <Run Text="【远兵克长兵】" FontWeight="Bold" Foreground="#A7F3D0" />
                                <Run Text="弓箭兵/弩兵 克 长枪兵" />
                            </TextBlock>
                        </Border>

                        <Border Background="#251C15" BorderBrush="#554433" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="0,0,8,4">
                            <TextBlock FontSize="11.5" Foreground="#FFE49E">
                                <Run Text="【短兵克远兵】" FontWeight="Bold" Foreground="#FFAB91" />
                                <Run Text="朴刀兵(盾) 克 弓箭兵/弩兵" />
                            </TextBlock>
                        </Border>

                        <Border Background="#2A1B18" BorderBrush="#884433" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="0,0,8,4">
                            <TextBlock FontSize="11.5" Foreground="#FFE49E">
                                <Run Text="【经典必背口诀】" FontWeight="Bold" Foreground="#FFD54F" />
                                <Run Text="藤甲极克飞弓 · 飞刀爆的链锤惨 · 大刀对女是短板 · 武斗不惧锤和缒 · 黄巾只克女飞蛮" />
                            </TextBlock>
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 2: 主工作区 (Tab: 全量卡片免选直览 vs 13x13 矩阵) -->
            <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="10,6,10,10">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder"
                                            Background="#211A15"
                                            BorderBrush="{StaticResource BrushGoldMuted}"
                                            BorderThickness="1,1,1,0"
                                            CornerRadius="4,4,0,0"
                                            Padding="18,7"
                                            Margin="0,0,4,0"
                                            Cursor="Hand">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#332418" />
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BrushGoldLight}" />
                                            <Setter Property="TextElement.Foreground" Value="#FFE6A3" />
                                            <Setter Property="TextElement.FontWeight" Value="Bold" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter Property="TextElement.Foreground" Value="#9E8F80" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#2D2117" />
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#8C6E3D" />
                                            <Setter Property="TextElement.Foreground" Value="#FFE6A3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: 13 兵种免选直览全谱卡片 (全部生克直接写好) -->
                <TabItem Header="📜 13兵种详细相克总谱 (免点击全览)">
                    <Border Background="#16120E" BorderBrush="{StaticResource BrushGoldMuted}" BorderThickness="1" CornerRadius="0,4,4,4" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AllTroopCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1F1813" BorderBrush="#3D3025" BorderThickness="1" CornerRadius="5" Margin="0,0,0,12" Padding="14,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <!-- 0: 兵种名与类别勋章 + 战术口诀 -->
                                                    <RowDefinition Height="Auto" />
                                                    <!-- 1: 优势克制 (+胜) -->
                                                    <RowDefinition Height="Auto" />
                                                    <!-- 2: 劣势受制 (-败) -->
                                                    <RowDefinition Height="Auto" />
                                                    <!-- 3: 势均力敌与实战说明 -->
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 0: 标题排 -->
                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TroopName}" FontFamily="{StaticResource FontLiSu}" FontSize="18" FontWeight="Bold" Foreground="#FFE6A3" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <Border Background="{Binding CategoryColor}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding CategoryName}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- 经典箴言 -->
                                                    <Border Grid.Column="1" Background="#17120E" BorderBrush="#35281F" BorderThickness="1" CornerRadius="3" Padding="8,3" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding ChantQuote}" FontSize="11.5" Foreground="{StaticResource BrushGoldLight}" FontStyle="Italic" />
                                                    </Border>
                                                </Grid>

                                                <!-- 1: 优势克制 (大胜绿标直接写明全部克谁) -->
                                                <Border Grid.Row="1" Background="#16271B" BorderBrush="#254B31" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="⚔️ 优势克制" FontSize="12" FontWeight="Bold" Foreground="#69F0AE" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding StrongBadges}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">
                                                                        <TextBlock Text="{Binding DisplayText}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding BadgeForeground}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>

                                                <!-- 2: 劣势受制 (大败红标直接写明被谁克) -->
                                                <Border Grid.Row="2" Background="#2B1515" BorderBrush="#502424" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🛡️ 劣势受制" FontSize="12" FontWeight="Bold" Foreground="#FF8A80" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding WeakBadges}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">
                                                                        <TextBlock Text="{Binding DisplayText}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding BadgeForeground}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>

                                                <!-- 3: 均势平局与战术特性说明 -->
                                                <Grid Grid.Row="3" Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Characteristics, StringFormat='【战术精要】{0}'}" FontSize="11.5" Foreground="#BDA996" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                    <!-- 均势平局徽章 -->
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding EvenBadges}" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="4,0,0,0">
                                                                    <TextBlock Text="{Binding DisplayText}" FontSize="10.5" Foreground="{Binding BadgeForeground}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- TAB 2: 13x13 兵种全局生克大矩阵 (行我方 vs 列敌兵) -->
                <TabItem Header="⊞ 13×13 全局生克矩阵 (横行我方 vs 竖列敌方)">
                    <Border Background="#16120E" BorderBrush="{StaticResource BrushGoldMuted}" BorderThickness="1" CornerRadius="0,4,4,4" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 说明与图例 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#1A1511" BorderBrush="#4A3B2C" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,12,0">
                                    <TextBlock Text="※ 横向行：我方兵种 ； 纵向列：敌方迎战兵种。正数(绿)代表我胜，负数(红)代表我败。" FontSize="11.5" Foreground="{StaticResource BrushGoldLight}" />
                                </Border>
                                <Border Background="#1B3B24" BorderBrush="#00E676" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="0,0,6,0">
                                    <TextBlock Text="+胜优势 (高胜率)" FontSize="11" Foreground="#69F0AE" />
                                </Border>
                                <Border Background="#3E1818" BorderBrush="#FF5252" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="0,0,6,0">
                                    <TextBlock Text="-败劣势 (大受克)" FontSize="11" Foreground="#FF8A80" />
                                </Border>
                                <Border Background="#1E1A16" BorderBrush="#78716C" BorderThickness="1" CornerRadius="2" Padding="6,1">
                                    <TextBlock Text="平局势均" FontSize="11" Foreground="#A8A29E" />
                                </Border>
                            </StackPanel>

                            <!-- 矩阵表内容 -->
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- 列表头 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <!-- 左上角空位 -->
                                        <Border Width="80" Height="30" Background="#261E17" BorderBrush="#4D3B2B" BorderThickness="1" Margin="0,0,2,0">
                                            <TextBlock Text="我 \ 敌" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushGoldLight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- 13 列头 -->
                                        <ItemsControl ItemsSource="{Binding TroopMatrixHeaders}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="56" Height="30" Background="#261E17" BorderBrush="#4D3B2B" BorderThickness="1" Margin="0,0,2,0">
                                                        <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="Bold" Foreground="#FFE49E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 行数据 -->
                                    <ItemsControl ItemsSource="{Binding TroopMatrixRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <!-- 行标题 (我方兵种) -->
                                                    <Border Width="80" Height="28" Background="#231B15" BorderBrush="#4D3B2B" BorderThickness="1" Margin="0,0,2,0">
                                                        <TextBlock Text="{Binding RowHeader}" FontSize="11" FontWeight="Bold" Foreground="#FFE6A3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- 行单元格 -->
                                                    <ItemsControl ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="56" Height="28"
                                                                        Background="{Binding Background}"
                                                                        BorderBrush="#382E24"
                                                                        BorderThickness="0.6"
                                                                        Margin="0,0,2,0"
                                                                        ToolTip="{Binding ToolTip}">
                                                                    <TextBlock Text="{Binding Text}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="{Binding Foreground}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
